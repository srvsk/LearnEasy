<Application x:Class="LearnEasy.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LearnEasy.Wpf.ViewModels"
             xmlns:views="clr-namespace:LearnEasy.Wpf.Views">
    <!-- No StartupUri: the host shows the main window after DI + DB init. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/KidFriendly.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Convention-based navigation: a view model renders as its view. -->
            <DataTemplate DataType="{x:Type vm:StartViewModel}">
                <views:StartView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LessonViewModel}">
                <views:LessonView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
