<Project Sdk="Aspire.AppHost.Sdk/13.1.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>747dadcf-e95e-4c03-9d2d-535a021be072</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire hosting integrations: PostgreSQL + Ollama (community toolkit). -->
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.1.0" />
    <!-- Community toolkit Ollama integration. If restore can't find this exact
         version, run: dotnet add package CommunityToolkit.Aspire.Hosting.Ollama -->
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Ollama" Version="9.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppHost launches the WPF client and injects connection strings. -->
    <ProjectReference Include="..\LearnEasy.Wpf\LearnEasy.Wpf.csproj" />
  </ItemGroup>

</Project>
